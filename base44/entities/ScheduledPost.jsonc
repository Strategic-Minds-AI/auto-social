{
  "name": "ScheduledPost",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Reference to Business"
    },
    "campaign_id": {
      "type": "string",
      "description": "Optional Campaign this post belongs to"
    },
    "content_draft_id": {
      "type": "string",
      "description": "Optional ContentDraft this post was promoted from"
    },
    "social_account_id": {
      "type": "string",
      "description": "SocialAccount this post publishes through"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "facebook",
        "linkedin",
        "x"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "post",
        "story",
        "reel",
        "image"
      ],
      "default": "post"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Local calendar day the post goes out"
    },
    "scheduled_time": {
      "type": "string",
      "description": "Local posting time, e.g. 09:00"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone the date and time are expressed in",
      "default": "America/New_York"
    },
    "scheduled_at": {
      "type": "string",
      "description": "Derived UTC instant this post becomes due"
    },
    "pillar": {
      "type": "string",
      "description": "Content pillar / theme this post belongs to"
    },
    "trend_topic": {
      "type": "string",
      "description": "Researched topic this post was built on, taken from the ranked topic list"
    },
    "title": {
      "type": "string"
    },
    "hook": {
      "type": "string",
      "description": "Opening hook line"
    },
    "caption": {
      "type": "string",
      "description": "Post caption / copy"
    },
    "hashtags": {
      "type": "string"
    },
    "call_to_action": {
      "type": "string"
    },
    "image_prompt": {
      "type": "string",
      "description": "AI image generation prompt"
    },
    "image_url": {
      "type": "string",
      "description": "Attached image URL"
    },
    "video_script": {
      "type": "string",
      "description": "Script for reels / short video"
    },
    "variant_b_caption": {
      "type": "string",
      "description": "Alternate caption used for A/B testing"
    },
    "ab_test": {
      "type": "boolean",
      "default": false
    },
    "ab_result": {
      "type": "string",
      "enum": [
        "pending",
        "variant_a",
        "variant_b"
      ],
      "default": "pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "approved",
        "scheduled",
        "publishing",
        "published",
        "failed",
        "cancelled"
      ],
      "default": "planned"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of the user who approved this post"
    },
    "approved_at": {
      "type": "string"
    },
    "approval_note": {
      "type": "string"
    },
    "cancelled_reason": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Stable key that prevents the same post being published twice"
    },
    "lock_token": {
      "type": "string",
      "description": "Set while a publishing run holds this post"
    },
    "locked_at": {
      "type": "string"
    },
    "publish_attempts": {
      "type": "number",
      "default": 0
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "last_attempt_at": {
      "type": "string"
    },
    "publish_error": {
      "type": "string"
    },
    "external_post_id": {
      "type": "string",
      "description": "ID returned by the platform after publishing"
    },
    "published_at": {
      "type": "string"
    },
    "published_url": {
      "type": "string"
    },
    "publish_history": {
      "type": "array",
      "description": "Receipt trail of approval, publishing attempts and failures",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event mirrored from this post"
    },
    "google_task_id": {
      "type": "string",
      "description": "Google Task opened for this post while it waits for review"
    },
    "google_sync_hash": {
      "type": "string",
      "description": "Hash of the mirrored fields, so an unchanged post is never re-sent to Google"
    }
  },
  "required": [
    "business_id",
    "platform",
    "scheduled_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}