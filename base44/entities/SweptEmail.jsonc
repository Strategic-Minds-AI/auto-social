{
  "name": "SweptEmail",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "Gmail message id that a sweep has already read"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When that email arrived"
    },
    "is_enquiry": {
      "type": "boolean",
      "default": false,
      "description": "Whether the sweep filed this email as a lead"
    }
  },
  "required": [
    "message_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}