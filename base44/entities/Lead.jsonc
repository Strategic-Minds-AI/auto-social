{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Enquirer's name"
    },
    "email": {
      "type": "string",
      "description": "Enquirer's email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number, only when the enquiry itself gave one"
    },
    "company": {
      "type": "string",
      "description": "Company name, only when stated"
    },
    "service": {
      "type": "string",
      "description": "What the enquiry is about"
    },
    "message": {
      "type": "string",
      "description": "What they asked for"
    },
    "source": {
      "type": "string",
      "enum": [
        "email",
        "manual"
      ],
      "default": "email",
      "description": "Where the lead came from"
    },
    "source_ref": {
      "type": "string",
      "description": "Gmail message id, so the same email is never filed twice"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the enquiry arrived"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string",
      "description": "Owner's own notes on this lead"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}