{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Enquirer's name, or the number they texted from when a text carries no name"
    },
    "email": {
      "type": "string",
      "description": "Enquirer's email address, when the enquiry came by email"
    },
    "phone": {
      "type": "string",
      "description": "Phone number the enquiry came from, or one given in the message"
    },
    "company": {
      "type": "string",
      "description": "Company name, only when stated"
    },
    "service": {
      "type": "string",
      "description": "What the enquiry is about"
    },
    "message": {
      "type": "string",
      "description": "What they asked for"
    },
    "source": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "manual"
      ],
      "default": "email",
      "description": "Which of the owner's communications this enquiry arrived on"
    },
    "source_ref": {
      "type": "string",
      "description": "Gmail message id or Twilio message id, so the same enquiry is never filed twice"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the enquiry arrived"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "closed"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string",
      "description": "Owner's own notes on this lead"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}