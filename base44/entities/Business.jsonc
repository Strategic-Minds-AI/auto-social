{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business name"
    },
    "description": {
      "type": "string",
      "description": "Business description"
    },
    "website": {
      "type": "string",
      "description": "Business website URL"
    },
    "industry": {
      "type": "string",
      "description": "Industry/niche"
    },
    "services": {
      "type": "string",
      "description": "Services or products offered, as the owner described them"
    },
    "service_area": {
      "type": "string",
      "description": "Where the business serves customers"
    },
    "differentiators": {
      "type": "string",
      "description": "What makes this business different from its competitors"
    },
    "primary_goal": {
      "type": "string",
      "description": "What the owner most wants the content to achieve"
    },
    "primary_platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "instagram",
          "facebook",
          "linkedin",
          "x"
        ]
      },
      "description": "Platforms chosen during onboarding, used as the default for new content plans"
    },
    "target_audience": {
      "type": "string",
      "description": "Target audience description"
    },
    "tone": {
      "type": "string",
      "enum": [
        "professional",
        "casual",
        "playful",
        "luxury",
        "inspirational",
        "educational"
      ],
      "default": "professional"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "instagram": {
          "type": "string"
        },
        "facebook": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "google_business": {
          "type": "string"
        }
      }
    },
    "brand_colors": {
      "type": "string",
      "description": "Brand colors (hex codes or descriptions)"
    },
    "logo_url": {
      "type": "string"
    },
    "brand_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded brand reference images used for AI image/video generation"
    },
    "analysis": {
      "type": "string",
      "description": "AI-generated business analysis"
    },
    "onboarded_at": {
      "type": "string",
      "description": "When the guided onboarding last completed for this business"
    },
    "notification_phone": {
      "type": "string",
      "description": "Mobile number that receives text alerts and can reply to approve posts"
    },
    "sms_alerts": {
      "type": "boolean",
      "default": false,
      "description": "Send a text when one of this business's posts goes live or fails"
    },
    "sms_opt_out": {
      "type": "boolean",
      "default": false,
      "description": "Set when the owner replies STOP from the notification phone"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}