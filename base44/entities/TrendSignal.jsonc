{
  "name": "TrendSignal",
  "type": "object",
  "properties": {
    "industry": {
      "type": "string",
      "description": "Industry or niche this signal was gathered for"
    },
    "niche_key": {
      "type": "string",
      "description": "Normalised industry text, so a scan replaces the previous list for the same industry"
    },
    "business_id": {
      "type": "string",
      "description": "Business the scan was run for, when one was chosen"
    },
    "owner_id": {
      "type": "string",
      "description": "App user who ran the scan; set server-side so the owner can read their own signals"
    },
    "region": {
      "type": "string",
      "description": "Market the signal was read in"
    },
    "platform": {
      "type": "string",
      "enum": [
        "youtube",
        "facebook",
        "instagram",
        "linkedin",
        "x",
        "tiktok",
        "google_trends",
        "google_news"
      ]
    },
    "source": {
      "type": "string",
      "description": "Where this was read from: youtube_most_popular, google_trends_rising, google_news_latest or own_channel"
    },
    "kind": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "post",
        "search",
        "article"
      ]
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "creator": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "format": {
      "type": "string",
      "description": "Shape of the content: short_video, mid_video, long_video, image, post, search or article"
    },
    "category": {
      "type": "string",
      "description": "Bucket from the source, e.g. the chart a video was found in"
    },
    "keyword": {
      "type": "string",
      "description": "Search phrase, for search signals"
    },
    "momentum": {
      "type": "string",
      "enum": [
        "rising",
        "steady",
        "declining"
      ]
    },
    "approx_searches": {
      "type": "number",
      "description": "Approximate search volume the source reports, when it gives one"
    },
    "views": {
      "type": "number"
    },
    "likes": {
      "type": "number"
    },
    "comments": {
      "type": "number"
    },
    "shares": {
      "type": "number"
    },
    "engagements": {
      "type": "number"
    },
    "engagement_rate": {
      "type": "number",
      "description": "Engagements as a percentage of views"
    },
    "score": {
      "type": "number",
      "description": "0 to 100 overall strength of this signal"
    },
    "hook_type": {
      "type": "string"
    },
    "hook_text": {
      "type": "string",
      "description": "Opening line rewritten for this industry, ready to reuse"
    },
    "why_it_works": {
      "type": "string"
    },
    "takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short pattern labels such as fast-cut, voiceover, text-overlay"
    },
    "visual_style": {
      "type": "string"
    },
    "audio_style": {
      "type": "string"
    },
    "faceless_friendly": {
      "type": "boolean",
      "default": false,
      "description": "Whether this can be made without showing a face"
    },
    "captured_at": {
      "type": "string"
    }
  },
  "required": [
    "industry",
    "platform",
    "kind",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}