{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "publish_due_posts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "publish_due_posts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publishDuePosts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Publish due posts",
            "description": "Every 5 minutes"
          }
        }
      }
    ]
  },
  "name": "Publish Due Posts",
  "description": "Publishes every approved and scheduled social post whose slot has passed. Runs every 5 minutes and is safe to re-run: each post is claimed exclusively and published at most once.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}