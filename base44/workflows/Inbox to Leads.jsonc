{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every morning, sweeps the shared Google inbox and files genuine enquiries as leads.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "inbox_to_leads",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_inbox": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanInboxForLeads"
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep inbox for enquiries",
            "description": "Files new leads"
          }
        }
      }
    ]
  },
  "name": "Inbox to Leads"
}