{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every Monday morning, builds the coming Monday-to-Sunday week of content for each business and mirrors that week into Google Calendar. A week that already has posts is left untouched, so content is never planned twice.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_social_weekly_plan",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "plan_the_week": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateAutoSocialPlan",
            "args": {
              "days": 7,
              "posts_per_week": 5,
              "align_week": true
            }
          },
          "then": "mirror_week_to_calendar",
          "x-base44": {
            "title": "Plan the coming week",
            "description": "One whole Monday-to-Sunday week per business"
          }
        }
      },
      {
        "mirror_week_to_calendar": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleWorkspace",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Put the week in Google Calendar",
            "description": "Adds or updates each post's calendar entry"
          }
        }
      }
    ]
  },
  "name": "Auto Social Weekly Plan"
}