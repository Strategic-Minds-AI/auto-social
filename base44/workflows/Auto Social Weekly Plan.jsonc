    }
  },
  "description": "Every Monday morning, tops up the Auto Social content calendar so each business always has 30 days of posts planned ahead. Skips any business that already has more than 14 days of runway.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_social_weekly_plan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "top_up_content_plans": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateAutoSocialPlan",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Top up content plans",
            "description": "Plans the next 30 days for each business"
          }
        }
      }
    ]
  },
  "name": "Auto Social Weekly Plan"
}